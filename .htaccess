<IfModule mod_rewrite.c>
  RewriteEngine On

  # ═══ SECURITY: Block access to sensitive files ═══════════════════
  # Block .env files, .git, source code, and config files
  RewriteRule ^\.env - [F,L]
  RewriteRule ^\.env\..*$ - [F,L]
  RewriteRule ^\.git - [F,L]
  RewriteRule ^\.htaccess$ - [F,L]
  RewriteRule ^\.user\.ini$ - [F,L]
  RewriteRule ^server/ - [F,L]
  RewriteRule ^src/ - [F,L]
  RewriteRule ^node_modules/ - [F,L]
  RewriteRule ^prisma/ - [F,L]
  RewriteRule ^tsconfig - [F,L]
  RewriteRule ^vite\.config - [F,L]
  RewriteRule ^package\.json$ - [F,L]
  RewriteRule ^package-lock\.json$ - [F,L]
  RewriteRule ^bun\.lock - [F,L]
  RewriteRule ^yarn\.lock$ - [F,L]
  RewriteRule \.map$ - [F,L]

  # Block common backup/temp file patterns
  RewriteRule \.(bak|sql|log|old|orig|swp|swo)$ - [F,L]
  RewriteRule ~$ - [F,L]

  # ═══ SECURITY HEADERS ═══════════════════════════════════════════
  <IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    # Enable XSS filter
    Header set X-XSS-Protection "1; mode=block"
    # Referrer policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    # Permissions policy
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Strict Transport Security (HTTPS only) — 1 year
    Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # Remove server version info
    Header unset X-Powered-By
    Header unset Server
  </IfModule>

  # Route google-feed.xml and google-promotions.xml directly to the API endpoints
  RewriteRule ^google-feed\.xml$ /api/products/google-feed [L,NC]
  RewriteRule ^google-promotions\.xml$ /api/products/google-promotions [L,NC]

  # Keep API calls handled by backend/proxy config
  RewriteCond %{REQUEST_URI} ^/api [NC]
  RewriteRule ^ - [L]

  # If request is not an existing file or directory, route to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# Block directory listing
<IfModule mod_autoindex.c>
  Options -Indexes
</IfModule>

# Deny access to hidden files (starting with dot)
<FilesMatch "^\.">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
</FilesMatch>